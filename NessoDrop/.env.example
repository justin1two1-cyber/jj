# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=nessosecret
DATABASE_URL=postgres://nesso:nessosecret@localhost:5432/nessodrop
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_64_char_random_string

# ─── OpenAI (shared with VallTech) ───────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── Stripe (customer Stripe account) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_URL=https://api.nessotec.com/api/orders/webhook

# ─── Owner Stripe (separate owner billing account) ────────────────────────────
# Stored in DB settings under owner user — not environment variables

# ─── Shopify Integration ──────────────────────────────────────────────────────
# Stored per-user in DB settings table via /api/integrations
# Keys: shopify_store_domain, shopify_access_token, shopify_webhook_secret

# ─── TikTok Ads / TikTok Business API ────────────────────────────────────────
# Stored per-user in DB settings table
# Keys: tiktok_ads_account_id, tiktok_client_key, tiktok_client_secret, tiktok_access_token

# ─── Meta Ads ─────────────────────────────────────────────────────────────────
# Stored per-user in DB settings table
# Keys: meta_ads_account_id, meta_access_token

# ─── Google Ads ───────────────────────────────────────────────────────────────
# Stored per-user in DB settings table
# Keys: google_ads_customer_id, google_ads_developer_token

# ─── Video Generation ─────────────────────────────────────────────────────────
HEYGEN_API_KEY=your_heygen_api_key_here
# D-ID as alternative: DID_API_KEY=...

# ─── Discovery APIs ───────────────────────────────────────────────────────────
RAINFOREST_API_KEY=your_rainforest_key        # Amazon BSR/movers data
SERPAPI_KEY=your_serpapi_key                  # eBay sold listings via SerpAPI

# ─── Supplier APIs ────────────────────────────────────────────────────────────
ALIEXPRESS_APP_KEY=your_aliexpress_key
ALIEXPRESS_APP_SECRET=your_aliexpress_secret
CJ_API_KEY=your_cjdropshipping_key
# Spocket: stored in DB settings table

# ─── SMTP (Owner mail reports) ────────────────────────────────────────────────
# Stored in DB settings under owner: smtp_host, smtp_port, smtp_user, smtp_password

# ─── Cloudflare ───────────────────────────────────────────────────────────────
# Stored in DB settings under owner: cloudflare_zone_id, cloudflare_api_token
# Domains: app.nessotec.com (dashboard), api.nessotec.com (API), downloads (customer packs)

# ─── Service Ports ────────────────────────────────────────────────────────────
# Platform API:    3001
# Dashboard:       3003 (app.nessotec.com)
# Owner Console:   3010
# Postgres:        5432
# Redis:           6379
