[
  {
    "id": "tmpl_timber_deck",
    "name": "Timber Deck",
    "category": "decking",
    "description": "Standard timber deck build with posts, bearers, joists, and decking boards",
    "measurementFields": [
      { "name": "length", "label": "Deck Length", "unit": "m", "required": true },
      { "name": "width", "label": "Deck Width", "unit": "m", "required": true },
      { "name": "height", "label": "Height from Ground", "unit": "m", "required": true, "default": 0.6 },
      { "name": "steps", "label": "Number of Steps", "unit": "count", "required": false, "default": 0 }
    ],
    "defaultMaterials": [
      { "materialId": "decking_board_140", "qtyFormula": "ceil((area / 0.14) * wasteFactor)", "wasteFactor": 1.1 },
      { "materialId": "joist_90x45", "qtyFormula": "ceil(length / 0.45) * width", "wasteFactor": 1.05 },
      { "materialId": "bearer_140x45", "qtyFormula": "ceil(width / 1.8) * length", "wasteFactor": 1.05 },
      { "materialId": "post_100x100", "qtyFormula": "ceil(length / 1.8) * ceil(width / 1.8)", "wasteFactor": 1.0 },
      { "materialId": "concrete_20kg", "qtyFormula": "posts * 2", "wasteFactor": 1.0 },
      { "materialId": "coach_bolt_m10", "qtyFormula": "posts * 4", "wasteFactor": 1.0 },
      { "materialId": "screw_10g_50mm", "qtyFormula": "ceil(area * 20 / 500)", "wasteFactor": 1.0 },
      { "materialId": "joist_hanger", "qtyFormula": "ceil(length / 0.45) * ceil(width / 1.8)", "wasteFactor": 1.0 }
    ],
    "labourFormula": "area * 1.5 + steps * 2",
    "consumablesPercent": 5
  },
  {
