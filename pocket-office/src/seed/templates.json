  {
    "id": "tmpl_bathroom_reno",
    "name": "Bathroom Renovation",
    "category": "renovation",
    "description": "Full bathroom renovation including demolition, waterproofing, tiling, and finishing",
    "measurementFields": [
      { "name": "floorArea", "label": "Floor Area", "unit": "sqm", "required": true },
      { "name": "wallArea", "label": "Wall Area to Tile", "unit": "sqm", "required": true },
      { "name": "hasShower", "label": "Includes Shower", "unit": "yes_no", "required": false, "default": 1 },
      { "name": "hasBath", "label": "Includes Bath", "unit": "yes_no", "required": false, "default": 0 }
    ],
    "defaultMaterials": [
      { "materialId": "waterproof_membrane", "qtyFormula": "ceil((floorArea + wallArea * 0.3) / 4)", "wasteFactor": 1.0 },
      { "materialId": "tile_floor_m2", "qtyFormula": "floorArea", "wasteFactor": 1.15 },
      { "materialId": "tile_wall_m2", "qtyFormula": "wallArea", "wasteFactor": 1.15 },
      { "materialId": "tile_adhesive_20kg", "qtyFormula": "ceil((floorArea + wallArea) / 4)", "wasteFactor": 1.0 },
      { "materialId": "tile_grout_5kg", "qtyFormula": "ceil((floorArea + wallArea) / 8)", "wasteFactor": 1.0 },
      { "materialId": "silicone_tube", "qtyFormula": "ceil((floorArea + wallArea) / 5)", "wasteFactor": 1.0 },
      { "materialId": "plasterboard_13mm", "qtyFormula": "ceil(wallArea * 0.3 / 2.88)", "wasteFactor": 1.1 }
    ],
    "labourFormula": "(floorArea + wallArea) * 1.5 + hasShower * 8 + hasBath * 4",
    "consumablesPercent": 5
  },
  {
    "id": "tmpl_roof_metal",
    "name": "Metal Roof Replacement",
    "category": "roofing",
    "description": "Strip existing roof and replace with colorbond roofing including battens, sarking, and flashings",
    "measurementFields": [
      { "name": "roofArea", "label": "Roof Area", "unit": "sqm", "required": true },
      { "name": "ridgeLength", "label": "Ridge Length", "unit": "m", "required": true },
      { "name": "gutterLength", "label": "Total Gutter Length", "unit": "m", "required": true },
      { "name": "downpipes", "label": "Number of Downpipes", "unit": "count", "required": false, "default": 4 }
    ],
    "defaultMaterials": [
      { "materialId": "colorbond_sheet", "qtyFormula": "roofArea / 0.762", "wasteFactor": 1.05 },
      { "materialId": "roof_batten", "qtyFormula": "roofArea * 1.5", "wasteFactor": 1.05 },
      { "materialId": "sarking", "qtyFormula": "ceil(roofArea / 30)", "wasteFactor": 1.0 },
      { "materialId": "ridge_cap", "qtyFormula": "ridgeLength", "wasteFactor": 1.05 },
      { "materialId": "flashing_custom", "qtyFormula": "ridgeLength * 0.5 + gutterLength * 0.2", "wasteFactor": 1.1 },
      { "materialId": "gutter_quad", "qtyFormula": "gutterLength", "wasteFactor": 1.05 },
      { "materialId": "downpipe_90mm", "qtyFormula": "downpipes * 3", "wasteFactor": 1.05 },
      { "materialId": "roofing_screw", "qtyFormula": "ceil(roofArea * 12 / 250)", "wasteFactor": 1.0 }
    ],
    "labourFormula": "roofArea * 0.5 + ridgeLength * 1 + gutterLength * 0.3",
    "consumablesPercent": 5
  },
  {
    "id": "tmpl_retaining_wall",
    "name": "Retaining Wall (Block)",
    "category": "landscaping",
    "description": "Concrete block retaining wall with drainage and backfill",
    "measurementFields": [
      { "name": "length", "label": "Wall Length", "unit": "m", "required": true },
      { "name": "height", "label": "Wall Height", "unit": "m", "required": true },
      { "name": "hasDrainage", "label": "Ag Drain Required", "unit": "yes_no", "required": false, "default": 1 }
    ],
    "defaultMaterials": [
      { "materialId": "retaining_block", "qtyFormula": "ceil(length / 0.4) * ceil(height / 0.2)", "wasteFactor": 1.05 },
      { "materialId": "concrete_20kg", "qtyFormula": "ceil(length * height * 0.3)", "wasteFactor": 1.0 },
      { "materialId": "reo_bar_12mm", "qtyFormula": "ceil(length / 0.6) + ceil(height / 0.4) * ceil(length / 6)", "wasteFactor": 1.1 },
      { "materialId": "gravel_20mm_tonne", "qtyFormula": "length * height * 0.3 * 1.6", "wasteFactor": 1.05 },
      { "materialId": "ag_drain_100mm", "qtyFormula": "hasDrainage * (length + 2)", "wasteFactor": 1.05 },
      { "materialId": "geofabric_m2", "qtyFormula": "hasDrainage * length * (height + 0.5)", "wasteFactor": 1.1 }
    ],
    "labourFormula": "length * height * 1.5 + hasDrainage * length * 0.5",
    "consumablesPercent": 4
  },
