      { "materialId": "paling_150x12", "qtyFormula": "ceil(length / 0.155)", "wasteFactor": 1.05 },
      { "materialId": "concrete_20kg", "qtyFormula": "(ceil(length / 2.4) + 1 + gates) * 2", "wasteFactor": 1.0 },
      { "materialId": "nail_75mm_framing", "qtyFormula": "ceil(length / 50)", "wasteFactor": 1.0 }
    ],
    "labourFormula": "length * 0.5 + gates * 2",
    "consumablesPercent": 3
  },
